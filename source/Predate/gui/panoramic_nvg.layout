FrameWidgetClass PredatePanoramicView {
 ignorepointer 1
 position 0 0
 size 1 1
 hexactpos 0
 vexactpos 0
 hexactsize 0
 vexactsize 0
 {
  ImageWidgetClass PredatePanoramicMask {
   ignorepointer 1
   position 0 0
   size 1 1
   hexactpos 0
   vexactpos 0
   hexactsize 0
   vexactsize 0
   mode blend
   "src alpha" 1
   "clamp mode" clamp
   "stretch mode" stretch_w_h
   filter 1
  }
 }
}
